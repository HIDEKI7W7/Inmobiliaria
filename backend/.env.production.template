# ============================================================
# .env.production — Propio Backend (PRODUCCIÓN)
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como `.env` en tu servidor o inyecta
#    estas variables en tu plataforma de despliegue (Railway, Render, etc.)
# 2. Nunca commitees este archivo con valores reales al repositorio.
# 3. El servidor ARRANCA sin credenciales OAuth — los endpoints
#    /auth/google|facebook|apple devuelven HTTP 503 hasta que
#    configures valores reales (longitud > 20 chars, sin placeholders).
# ============================================================

NODE_ENV=production

# ─── Base de datos ──────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST/NOMBRE_DB?sslmode=require"

# ─── JWT ────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRET_ALEATORIO_DE_64_BYTES_MINIMO"

# ─── URLs Públicas ──────────────────────────────────────────
BACKEND_PUBLIC_URL="https://api.tudominio.com"
FRONTEND_URL="https://tudominio.com"

# ─── Google OAuth ───────────────────────────────────────────
# Obtén en: https://console.cloud.google.com → APIs & Services → Credentials
# Formato clientID: xxxxxxxxxx.apps.googleusercontent.com (71 chars aprox.)
GOOGLE_CLIENT_ID="TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="TU_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="https://api.tudominio.com/api/auth/google/callback"

# ─── Facebook OAuth ─────────────────────────────────────────
# Obtén en: https://developers.facebook.com → Tu App → Configuración → Básica
# Formato appID: número de 15-16 dígitos
FACEBOOK_APP_ID="TU_FACEBOOK_APP_ID"
FACEBOOK_APP_SECRET="TU_FACEBOOK_APP_SECRET"
FACEBOOK_CALLBACK_URL="https://api.tudominio.com/api/auth/facebook/callback"

# ─── Apple Sign In ──────────────────────────────────────────
# Obtén en: https://developer.apple.com → Certificates → Services IDs & Keys
APPLE_CLIENT_ID="com.tuempresa.tuapp"
APPLE_TEAM_ID="TU_APPLE_TEAM_ID"
APPLE_KEY_ID="TU_APPLE_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCONTENIDO_DE_TU_ARCHIVO_.p8\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL="https://api.tudominio.com/api/auth/apple/callback"
